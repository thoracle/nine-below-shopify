{%- comment -%}
  Email capture.

  Kept from the live site, but reframed. "Updates & releases" asks the visitor
  to do the brand a favour. Naming what they get — allocation access before
  public release — gives them a reason. Single field, visible value, explicit
  consent line.

  Posts to Klaviyo when a company ID is configured; otherwise the demo handler
  in theme.js captures it locally so the flow and its GA4 events still work.
{%- endcomment -%}

<section class="section section--signup" id="{{ section.settings.anchor | default: 'updates' }}"
         data-section-name="email_capture">
  <div class="wrap wrap--narrow">
    <div class="signup">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="lead">{{ section.settings.body }}</p>
      {%- endif -%}

      <form class="signup__form" data-signup-form novalidate>
        <div class="signup__row">
          <label class="visually-hidden" for="signup-email">Email address</label>
          <input type="email" id="signup-email" name="email"
                 placeholder="{{ section.settings.placeholder }}"
                 autocomplete="email" required data-signup-email>
          <button type="submit" class="btn btn--primary" data-signup-submit>
            {{ section.settings.button_label }}
          </button>
        </div>

        <p class="signup__consent">{{ section.settings.consent_text }}</p>

        <p class="signup__msg signup__msg--ok" data-signup-success hidden>
          {{ section.settings.success_text }}
        </p>
        <p class="signup__msg signup__msg--err" data-signup-error hidden>
          {{ section.settings.error_text }}
        </p>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email capture",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "updates" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Allocation list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get first access to the next release" },
    {
      "type": "textarea", "id": "body", "label": "Body",
      "default": "The Winter Wheat is limited. Join the list and we will email you before the next bottling goes public — no more than a few times a year."
    },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "you@example.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the list" },
    {
      "type": "textarea", "id": "consent_text", "label": "Consent text",
      "default": "By joining you confirm you are of legal drinking age and agree to receive email from Nine Below. Unsubscribe any time."
    },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're on the list. Watch your inbox." },
    { "type": "text", "id": "error_text", "label": "Error message", "default": "Something went wrong. Please try again." }
  ],
  "presets": [{ "name": "Email capture" }]
}
{% endschema %}
