{%- comment -%}
  Announcement bar. Carries the one piece of information most likely to remove
  a purchase objection before it forms — shipping, allocation, or edition size.
{%- endcomment -%}

{%- if section.settings.enabled -%}
<div class="announce" data-announce
     {% if section.settings.dismissible %}data-dismissible{% endif %}>
  <div class="announce__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="announce__track" data-announce-track>
        {%- for block in section.blocks -%}
          <p class="announce__item" {{ block.shopify_attributes }}
             data-announce-item {% unless forloop.first %}hidden{% endunless %}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" data-track-cta="announcement">
                {{ block.settings.text }}
              </a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.dismissible -%}
      <button type="button" class="announce__close" data-announce-close
              aria-label="Dismiss announcement">&times;</button>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement bar", "default": true },
    { "type": "checkbox", "id": "dismissible", "label": "Allow dismissal", "default": true },
    {
      "type": "range", "id": "rotate_seconds", "label": "Rotate every",
      "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Limited winter release" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "message", "settings": { "text": "Limited winter release" } },
      { "type": "message", "settings": { "text": "Free shipping on 2+ bottles" } },
      { "type": "message", "settings": { "text": "Nine times distilled." } }
    ]
  },
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
