# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python toolchain
.venv/
__pycache__/
*.pyc

# Leftovers from the npm toolchain, removed 5 Aug 2026. Nothing generates these
# any more; the entries stay so that a stale node_modules on someone's disk — or
# an `npm install` run out of habit — cannot be committed.
node_modules/
package-lock.json

# Credentials for tools/ga4_pull.py. Never commit a service-account key.
*service-account*.json
*credentials*.json
gcp-*.json
.env
.env.*

# Local GA4 pulls
*.pull.json

# Local-only handover notes. restart.md lives in the PARENT folder, outside both
# repos, because it references the other brand and this repo must stay free of
# any cross-reference. This rule is insurance: if a copy ever lands in here, it
# does not get committed.
restart.md
HANDOVER.md
*.local.md

